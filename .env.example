# CoinPort environment. Copy to .env.local for local development (never commit
# real values). In production set these in Vercel → Project → Settings →
# Environment Variables, then redeploy. See docs/LAUNCH.md.

# Postgres (Neon). Vercel's Neon integration sets this for you.
# Local development without Postgres: DATABASE_URL=pglite:./.data/pglite
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Solana mainnet RPC endpoints, comma-separated, in priority order.
# The public endpoint is always added last as a fallback.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Public address of the site (used in the wallet sign-in message).
SITE_URL=https://your-project.vercel.app

# Protects /api/cron. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional: fallback image/metadata host if pump.fun's upload endpoint fails.
PINATA_JWT=

# Optional: CoinGecko demo API key (SOL/USD); Coinbase and Kraken are fallbacks.
COINGECKO_API_KEY=

# Public (shown to visitors): your token and X account for the top bar.
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_TWITTER_URL=
